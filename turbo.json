{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "outputs": ["dist/**"]
      },
      "clean": {
        "dependsOn": ["^clean"]
      },
      "test": {
        "dependsOn": ["^test"]
      },
      "test:unit": {},
      "typecheck": {
        "dependsOn": ["build"]
      },
      "lint": {
        "dependsOn": [
          "^lint"
        ]
      }
    }
  }